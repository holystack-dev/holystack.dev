---
import MainLayout from '../../layouts/MainLayout.astro';
import { confessionSteps, confessionGroups } from '../../data/confession';
const faqSchema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:confessionGroups.flatMap(group=>group.items.map(item=>({'@type':'Question',name:item.title,acceptedAnswer:{'@type':'Answer',text:item.content}})))};
const howToSchema = {'@context':'https://schema.org','@type':'HowTo',name:'How to make a good confession',step:confessionSteps.map((step,index)=>({'@type':'HowToStep',position:index+1,name:step.title,text:step.summary}))};
---
<MainLayout title="A guide to confession | Metanoia by HolyStack" description="A step-by-step Catholic confession guide, with answers to common questions about preparing, the sacrament and penance.">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(faqSchema)}/><script type="application/ld+json" set:html={JSON.stringify(howToSchema)}/></Fragment>
  <section class="page-intro wrap reading"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/metanoia">Metanoia</a><span aria-hidden="true">/</span>Confession guide</nav><p class="eyebrow">The Sacrament of Reconciliation</p><h1 class="display">A guide to confession.</h1><p class="lede">Whether it’s your first time or you’re returning after a while, take one step at a time. The priest can help you through the rest.</p></section>
  <section class="wrap reading guide-steps" aria-label="Steps for confession"><ol>{confessionSteps.map((step,index)=><li><span class="step-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><div><h2>{step.title}</h2><p>{step.summary}</p></div></li>)}</ol></section>
  <section class="section wrap reading"><div class="section-heading"><p class="eyebrow">Questions about confession</p><h2 class="heading">Before you go.</h2></div><div class="faq-groups">{confessionGroups.map(group=><section><h3>{group.heading}</h3><div class="accordion">{group.items.map(item=><details><summary>{item.title}</summary><div class="answer">{item.content}</div></details>)}</div></section>)}</div><aside class="guide-sources notice legal"><h3>Further reading</h3><p>This guide introduces the sacrament. For the Church’s teaching and help with personal circumstances, read the sources below and speak with your parish priest.</p><ul><li><a href="https://www.usccb.org/prayer-and-worship/sacraments-and-sacramentals/penance/examinations-of-conscience">USCCB: examinations of conscience</a></li><li><a href="https://www.vatican.va/content/catechism/en/part_two/section_two/chapter_two/article_4/vii_the_acts_of_the_penitent.html">Catechism: contrition, confession and penance</a></li><li><a href="https://www.vatican.va/content/catechism/en/part_two/section_two/chapter_two/article_4/viii_the_minister_of_this_sacrament.html">Catechism: the priest’s ministry and the sacramental seal</a></li><li><a href="https://www.vatican.va/content/catechism/en/part_two/section_two/chapter_two/article_4/xi_the_celebration_of_the_sacrament_of_penance.html">Catechism: celebrating the sacrament</a></li><li><a href="https://www.vatican.va/content/catechism/en/part_two/section_two/chapter_two/article_4/x_indulgences.html">Catechism: indulgences</a></li></ul></aside><div class="actions"><a href="/metanoia" class="action secondary">Back to Metanoia</a></div></section>
</MainLayout>
<style>
  .guide-sources { margin-top: 48px; }
  .guide-sources h3 { font-size: 1.4rem; margin-bottom: 16px; }
  .guide-steps ol { list-style: none; padding: 0; }
  .guide-steps { padding: 10px 30px; border: 1px solid var(--site-line); border-radius: 16px; background: var(--site-card); }
  .guide-steps li:first-child { border: 0; }
  .guide-steps li { display: flex; gap: 24px; padding: 26px 0; border-top: 1px solid var(--site-line); }
  .step-number { color: var(--site-accent); font-size: .85rem; padding-top: 6px; width: 30px; flex-shrink: 0; }
  .guide-steps h2 { font-size: 1.45rem; font-weight: 400; margin: 0 0 10px; }
  .guide-steps p { color: var(--site-muted); font-size: .94rem; line-height: 1.85; }
  .faq-groups { display: grid; gap: 48px; }
  .faq-groups h3 { font-weight: 400; font-size: 1.3rem; margin-bottom: 20px; }
</style>
