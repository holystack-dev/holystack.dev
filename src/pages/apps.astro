---
import MainLayout from '../layouts/MainLayout.astro';
import ProductCard from '../components/common/ProductCard.astro';
import GitHubIcon from '../components/common/GitHubIcon.astro';
import { projects } from '../data/projects';
---
<MainLayout title="Projects | HolyStack" description="Explore HolyStack’s Catholic apps and open projects: Metanoia for confession and daily reflection, and Shema for listening to Scripture offline.">
  <section class="page-intro wrap"><p class="eyebrow">The studio’s work</p><h1 class="display">Catholic apps<br />and open projects.</h1><p class="lede">Every HolyStack project is made for Catholic prayer and the life of the Church, from confession and daily reflection to listening to Scripture.</p></section>
  <section class="wrap project-list" aria-label="HolyStack projects">{projects.map(project => <ProductCard project={project} eager/>)}</section>
  <section class="section wrap"><div class="next-projects"><div><p class="eyebrow">Work in progress</p><h2 class="heading">More to come.</h2><p class="lede">Further projects are in development. We’ll add them here when they’re ready to share.</p></div><div class="contribute"><h3>Contribute to a project</h3><p>The repositories are open to code contributions, translations, bug reports and suggestions.</p><a class="text-link" href="https://github.com/holystack-dev"><GitHubIcon /> HolyStack on GitHub</a></div></div></section>
</MainLayout>
<style>
  .project-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 36px; }
  .next-projects { display: grid; grid-template-columns: 1.2fr 1fr; align-items: start; gap: 100px; border-top: 1px solid var(--site-line); padding-top: 56px; }
  .contribute { padding: 32px; background: var(--site-soft); border-radius: 16px; }
  .contribute h3 { font-size: 1.5rem; margin-bottom: 16px; }
  .contribute p { color: var(--site-muted); font-size: .9rem; line-height: 1.8; margin-bottom: 18px; }
  @media(max-width: 760px) { .project-list, .next-projects { grid-template-columns: 1fr; gap: 44px; }.contribute { padding: 26px; } }
</style>
