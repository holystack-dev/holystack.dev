---
import MainLayout from '../../layouts/MainLayout.astro';
import '../../styles/shema.css';
import DeviceFrame from '../../components/shema/DeviceFrame.astro';
import GitHubIcon from '../../components/common/GitHubIcon.astro';
import DeviceTour from '../../components/shema/DeviceTour.astro';
import { SHEMA_GITHUB, screen, listening, gallery } from '../../data/shema';

const details = [
  ['Resume listening', 'Resume the last track at the saved position. Recent listening and played markers show what you have listened to.'],
  ['Touch controls', 'Larger touch areas and improved folder navigation help when browsing a large library.'],
  ['Favourite and timer indicators', 'A filled heart shows a saved track. A filled moon shows an active sleep timer.'],
  ['Confirmation before removal', 'Shema asks for confirmation before removing a favourite or clearing played history.'],
];
---

<MainLayout
  title="Shema Offline Audio Bible | HolyStack"
  description="Shema is an offline audio Bible player with chapter navigation, Bible in a Year, an audio library, favourites, resume and a sleep timer."
>
  <div class="shema-page shema-theme">
    <section class="hero" aria-labelledby="shema-title">
      <div class="page-width hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">OFFLINE AUDIO BIBLE</p>
          <h1 id="shema-title">Shema<br /><span>The Bible, aloud.</span></h1>
          <p class="hero-lead">Listen to the Bible, follow Bible in a Year (BIY) and play your own prayers, music and talks. No phone or internet needed.</p>
          <div class="hero-actions"><a class="action primary" href="#get-started">Set up a device <span aria-hidden="true">↗</span></a><a class="action secondary" href="#device-tour">Watch the tour <span aria-hidden="true">↓</span></a></div>
          <ul class="hero-facts" aria-label="Shema at a glance"><li>Fully offline</li><li>No account</li><li>Open source</li></ul>
          <p class="name-note"><span lang="he" dir="rtl">שְׁמַע</span> is Hebrew for “Hear”.</p>
        </div>
        <figure class="hero-device"><DeviceFrame view="angled" src={screen('home')} alt="The full Shema device with its round display, speaker enclosure and USB ports" size={350} eager/><figcaption>A dedicated player for Scripture and your audio library.</figcaption></figure>
      </div>
    </section>

    <section class="listening-section section-space" id="discover" aria-labelledby="listening-title">
      <div class="page-width">
        <div class="section-intro"><p class="eyebrow">LISTENING OPTIONS</p><h2 id="listening-title">The Bible and your<br />audio library.</h2><p>Choose a Bible chapter, follow a daily reading plan or browse your own audio folders.</p></div>
        <div class="listening-grid">
          {listening.map(item => <article class="listening-card">
            <div class="card-device"><DeviceFrame src={screen(item.image)} alt={item.alt} size={272} /></div>
            <div class="card-copy"><p class="eyebrow">{item.eyebrow}</p><h3>{item.title}</h3><p>{item.text}</p></div>
          </article>)}
        </div>
      </div>
    </section>

    <section class="player-section section-space" aria-labelledby="player-title">
      <div class="page-width player-grid">
        <DeviceTour />
        <div class="player-copy"><p class="eyebrow">EXPLORE THE DEVICE</p><h2 id="player-title">Time to listen.</h2><p class="player-lead">Choose a feature to see it on the device. Browse Bible chapters, open your audio library and return to a favourite chapter.</p><p>Play, pause, adjust the volume or set a sleep timer. The progress ring shows how much of the current recording has played.</p><div class="player-chips"><span>Play & pause</span><span>Skip & seek</span><span>Favourites</span><span>Sleep timer</span></div></div>
      </div>
    </section>

    <section class="section-space gallery-section" aria-labelledby="gallery-title">
      <div class="page-width">
        <div class="section-intro"><p class="eyebrow">A CLOSER LOOK</p><h2 id="gallery-title">Explore the screens.</h2><p>Browse books and chapters, manage favourites and adjust settings on the round touchscreen.</p></div>
        <div class="screens-grid">
          {gallery.map(item => <figure class="screen-card"><div class="screen-preview"><DeviceFrame src={screen(item.image)} alt={`Shema ${item.title.toLowerCase()} screen`} size={224} /></div><figcaption><h3>{item.title}</h3><p>{item.text}</p></figcaption></figure>)}
        </div>
        <div class="details-grid">{details.map(([title, text]) => <article><span class="detail-mark" aria-hidden="true">+</span><h3>{title}</h3><p>{text}</p></article>)}</div>
      </div>
    </section>

    <section class="offline-section section-space" aria-labelledby="offline-title">
      <div class="page-width offline-grid"><div><p class="eyebrow">OFFLINE</p><h2 id="offline-title">Listen without a phone.</h2></div><div class="offline-copy"><p>Shema plays MP3 files from your microSD card. Listening does not need an account, internet connection or subscription.</p><p>Add Bible recordings in your preferred languages and keep songs, prayers and talks in the Library. The device charges over USB-C.</p><a href={SHEMA_GITHUB} class="text-link">Free, open-source firmware <span aria-hidden="true">↗</span></a></div></div>
    </section>

    <section class="section-space setup-section" id="get-started" aria-labelledby="setup-title">
      <div class="page-width">
        <div class="section-intro"><p class="eyebrow">GET STARTED</p><h2 id="setup-title">Set up your device.</h2><p>Choose the assembled hardware, add your audio and install the firmware from your computer.</p></div>
        <ol class="setup-grid">
          <li><span class="step-number">01</span><h3>Choose the hardware</h3><p>Use the <strong>Waveshare ESP32-S3-Touch-LCD-1.85C (V2)</strong>. The BOX + battery option (SKU 30684) includes the round touchscreen, speaker enclosure and battery.</p><a class="text-link" href="https://www.waveshare.com/esp32-s3-touch-lcd-1.85c.htm?sku=30684">View the device <span aria-hidden="true">↗</span></a><p class="small-note">Check the selected package and current price with the seller. <a href="https://docs.waveshare.com/ESP32-S3-Touch-LCD-1.85C">Hardware details</a></p></li>
          <li><span class="step-number">02</span><h3>Prepare the microSD card</h3><p><strong>Format the microSD card as FAT32.</strong> Back up any files first because formatting erases the card. Then copy your MP3s into the folders shown below.</p><a class="text-link" href="#audio-setup">See the folder layout <span aria-hidden="true">↓</span></a><p class="small-note">Audio recordings and the microSD card are supplied separately.</p></li>
          <li><span class="step-number">03</span><h3>Install & listen</h3><p>Connect with a USB-C data cable. Open the web installer in Chrome or Edge on a computer, choose the device and follow the installation steps.</p><a class="text-link" href="/shema/flash">Open the installer <span aria-hidden="true">→</span></a><p class="small-note">Setting up several for family or a parish? Repeat the same steps for each player.</p></li>
        </ol>

        <div class="audio-setup" id="audio-setup">
          <div><p class="eyebrow">YOUR MICROSD CARD</p><h3>microSD card setup</h3><p><strong>The microSD card must use FAT32.</strong> Use the folder names shown here at the root of the card. The language and Bible version folders can reflect your own collection.</p><ul class="folder-notes"><li><strong>BIBLE</strong>: chapter MP3s, numbered by book and chapter in the 73-book Catholic order.</li><li><strong>BIY</strong> (Bible in a Year): daily episodes and introductions inside each language folder.</li><li><strong>LIBRARY</strong>: your own folders and subfolders of MP3s.</li></ul><p class="small-note">Recordings are not bundled. Add audio you have permission to use.</p></div>
          <div class="folder-example"><span>EXAMPLE CARD LAYOUT</span><pre aria-label="Example microSD folder structure"><code>{`BIBLE/
  English/
    MyRecording/
      01_01.mp3
      01_02.mp3

BIY/
  English/
    Day 001 - In the Beginning.mp3
    Intro 01 - Introduction.mp3

LIBRARY/
  Prayers/
    Morning Prayer.mp3
  Songs/
  Talks/`}</code></pre></div>
        </div>
        <details class="setup-detail"><summary>A note on audio file names</summary><div><p>For Bible chapters, use <code>book_chapter.mp3</code>: <code>01_01.mp3</code> is Genesis 1. Keep numbering consistent across the recording. Book numbers run from 1 to 73 in Catholic Bible order.</p><p>Bible in a Year (BIY) files use <code>Day NNN - Title.mp3</code> for days 001 to 365 and <code>Intro NN - Title.mp3</code> for introductions. Keep the spaces and three-digit day numbers. Library tracks can keep their descriptive filenames.</p><a class="text-link" href={SHEMA_GITHUB}>Source code & setup guide <span aria-hidden="true">↗</span></a></div></details>
      </div>
    </section>

    <section class="closing-section section-space" aria-labelledby="closing-title"><div class="page-width"><p class="eyebrow">SHEMA</p><h2 id="closing-title">“Hear, O Israel.”</h2><p class="verse-ref">Deuteronomy 6:4</p><p class="closing-copy">Shema takes its name from the Hebrew word for “hear”.</p><div class="closing-actions"><a class="action primary" href="/shema/flash">Install Shema <span aria-hidden="true">→</span></a><a class="action secondary" href={SHEMA_GITHUB}><GitHubIcon /> Explore the source</a></div></div></section>
  </div>
</MainLayout>

<style>
  .page-width { width: min(1200px, calc(100% - 64px)); margin-inline: auto; }
  .section-space { padding-block: clamp(64px, 7.5vw, 104px); }
  .eyebrow { font-size: 11px; font-weight: 600; letter-spacing: .16em; line-height: 1.6; color: var(--shema-accent); margin-bottom: 20px; }
  .hero { padding: 64px 0; }
  .hero-device { display: grid; gap: 30px; padding: 38px 24px 28px; background: var(--product-shema); border: 1px solid var(--shema-line); border-radius: 18px; }
  .hero-device figcaption { text-align: center; font-size: .66rem; color: var(--shema-muted); line-height: 1.8; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 64px; align-items: center; }
  .hero-copy > .eyebrow { display: flex; gap: 12px; align-items: center; }
  h1 { font-size: clamp(54px, 5.5vw, 74px); font-weight: 400; line-height: 1.12; letter-spacing: -.04em; margin-bottom: 28px; }
  h1 span { color: var(--shema-accent); }
  .hero-lead { font-size: 18px; line-height: 1.85; color: var(--shema-muted); max-width: 470px; margin-bottom: 18px; }
  .hero-actions, .closing-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .action { display: inline-flex; align-items: center; justify-content: center; gap: 20px; min-height: 48px; padding: 12px 22px; border-radius: 8px; font-size: 13px; font-weight: 600; border: 1px solid transparent; transition: background .2s, border-color .2s; }
  .primary { background: var(--site-button); color: var(--site-button-text); }
  .primary:hover { box-shadow: 0 0 0 3px var(--shema-line); }
  .secondary { border-color: var(--shema-line); }
  .secondary:hover { border-color: var(--shema-accent); background: var(--shema-card); }
  .hero-facts { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 23px; padding: 0; list-style: none; font-size: 11px; font-weight: 500; color: var(--shema-muted); }
  .hero-facts li::before { content: '✓'; margin-right: 6px; color: var(--shema-accent); }
  .name-note { font-size: 11px; color: var(--shema-muted); margin-top: 26px; }
  .section-intro { max-width: 660px; margin-bottom: 48px; }
  h2 { font-size: clamp(32px, 3.5vw, 46px); line-height: 1.18; font-weight: 400; letter-spacing: -.03em; }
  .section-intro > p:last-child { margin-top: 20px; color: var(--shema-muted); font-size: 16px; line-height: 1.8; max-width: 560px; }
  .listening-section { border-top: 1px solid var(--shema-line); }
  .listening-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 22px; }
  .listening-card { background: var(--shema-card); border: 1px solid var(--shema-line); border-radius: 22px; overflow: hidden; }
  .card-device { padding: 35px 30px 32px; background: var(--product-shema); }
  .card-copy { padding: 28px; }
  .card-copy .eyebrow { font-size: 10px; margin-bottom: 14px; }
  h3 { font-size: 22px; line-height: 1.3; font-weight: 400; letter-spacing: -.02em; }
  .card-copy > p:last-child { font-size: 14px; line-height: 1.85; margin-top: 14px; color: var(--shema-muted); }
  .player-section { background: var(--site-soft); border-block: 1px solid var(--shema-line); }
  .player-grid { display: grid; grid-template-columns: 1fr 1.15fr; align-items: center; gap: 100px; }
  .player-figure { margin: 0; }
  .player-figure figcaption { text-align: center; margin-top: 28px; font-size: 11px; color: var(--shema-muted); }
  .player-copy .eyebrow { color: var(--shema-accent); }
  .player-lead { font-size: 19px; margin-top: 26px; color: var(--shema-ink); line-height: 1.65; }
  .player-lead + p { color: var(--shema-muted); font-size: 15px; line-height: 1.85; margin-top: 16px; }
  .player-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 26px; }
  .player-chips span { border: 1px solid var(--shema-line); padding: 7px 12px; border-radius: 6px; font-size: 11px; color: var(--shema-muted); }
  .screens-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 40px 24px; }
  .screen-preview { padding: 16px 10px 28px; }
  .screen-card h3 { font: 600 15px/1.5 var(--font-sans); letter-spacing: -.015em; margin-bottom: 8px; }
  .screen-card figcaption p { font-size: 13px; color: var(--shema-muted); line-height: 1.8; }
  .details-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 28px; border-top: 1px solid var(--shema-line); padding-top: 36px; margin-top: 64px; }
  .detail-mark { display: block; color: var(--shema-accent); font-size: 24px; margin-bottom: 14px; }
  .details-grid h3 { font: 600 14px/1.6 var(--font-sans); letter-spacing: 0; margin-bottom: 12px; }
  .details-grid p { font-size: 13px; line-height: 1.8; color: var(--shema-muted); }
  .offline-section { border-block: 1px solid var(--shema-line); background: var(--site-soft-alt); }
  .offline-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 100px; }
  .offline-copy > p { color: var(--shema-muted); font-size: 16px; line-height: 1.85; margin-bottom: 20px; }
  .text-link { display: inline-block; font-size: 13px; font-weight: 600; color: var(--shema-accent); padding-block: 9px; text-decoration: underline; text-underline-offset: 5px; text-decoration-color: transparent; }
  .text-link:hover { text-decoration-color: currentColor; }
  .setup-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 40px; list-style: none; padding: 0; }
  .setup-grid li { border-top: 1px solid var(--shema-line); padding-top: 22px; }
  .step-number { color: var(--shema-accent); display: block; font-size: 12px; margin-bottom: 26px; }
  .setup-grid h3 { margin-bottom: 18px; }
  .setup-grid p { font-size: 14px; color: var(--shema-muted); line-height: 1.85; margin-bottom: 12px; }
  .setup-grid strong { color: var(--shema-ink); font-weight: 500; }
  .small-note, .setup-grid .small-note { font-size: 12px; line-height: 1.8; color: var(--shema-muted); margin-top: 12px; }
  .small-note a { text-decoration: underline; text-underline-offset: 3px; }
  .audio-setup { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; margin-top: 76px; padding-top: 60px; border-top: 1px solid var(--shema-line); align-items: start; scroll-margin-top: 100px; }
  .audio-setup h3 { font-size: 32px; margin-bottom: 20px; }
  .audio-setup p:not(.eyebrow):not(.small-note) { color: var(--shema-muted); font-size: 14px; line-height: 1.85; }
  .folder-notes { list-style: none; padding: 0; margin-top: 20px; }
  .folder-notes li { color: var(--shema-muted); font-size: 13px; line-height: 1.8; margin-bottom: 12px; }
  .folder-notes strong { color: var(--shema-ink); font-size: 11px; letter-spacing: .05em; }
  .folder-example { min-width: 0; background: var(--site-soft); color: var(--shema-ink); border: 1px solid var(--shema-line); padding: 26px; border-radius: 18px; }
  .folder-example > span { font-size: 10px; letter-spacing: .12em; color: var(--shema-accent); }
  pre { font-size: 12px; line-height: 1.9; overflow-x: auto; padding-bottom: 10px; margin-top: 18px; }
  .setup-detail { margin-top: 32px; padding: 20px 24px; background: var(--shema-card); border: 1px solid var(--shema-line); border-radius: 12px; }
  summary { cursor: pointer; font-size: 14px; font-weight: 600; min-height: 24px; }
  .setup-detail > div { font-size: 13px; line-height: 1.9; color: var(--shema-muted); margin-top: 16px; max-width: 880px; }
  .setup-detail p + p { margin-top: 12px; }
  .setup-detail code { overflow-wrap: anywhere; font-size: 12px; }
  .closing-section { text-align: center; background: var(--shema-card); border-top: 1px solid var(--shema-line); }
  .closing-section h2 { font-size: clamp(36px,4vw,56px); }
  .verse-ref { font-size: 12px; color: var(--shema-accent); margin-top: 16px; }
  .closing-copy { color: var(--shema-muted); font-size: 15px; margin-top: 26px; }
  .closing-actions { justify-content: center; }
  section[id] { scroll-margin-top: 24px; }
  @media (max-width: 1000px) {
    .hero-grid { gap: 36px; }

    .player-grid { gap: 60px; }
    .card-device { padding: 28px 22px; }
    .card-copy { padding: 24px; }
    .screens-grid, .details-grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 36px; }
    .screen-card { max-width: 350px; }
    .offline-grid { gap: 50px; }
  }
  @media (max-width: 760px) {
    .page-width { width: calc(100% - 40px); }
    .section-space { padding-block: 64px; }
    .hero { padding: 48px 0 52px; }
    .hero-grid { grid-template-columns: 1fr; gap: 42px; }
    .hero-copy { max-width: 540px; }
    h1 { font-size: clamp(42px, 13.5vw, 58px); }
    .hero-lead { font-size: 19px; }
    .hero-facts { gap: 14px; }
    .name-note { margin-top: 20px; }
    .listening-grid { grid-template-columns: 1fr; gap: 22px; }
    .listening-card { display: grid; grid-template-columns: .85fr 1fr; align-items: center; }
    .card-device { padding: 28px 22px; height: 100%; display: flex; align-items: center; }
    .card-copy { padding: 24px; }
    .player-grid, .offline-grid, .audio-setup { grid-template-columns: 1fr; gap: 42px; }
    .player-grid :global(device-tour) { order: 2; }
    .player-copy { max-width: 520px; }
    .player-figure :global(.device) { max-width: 310px; }
    .setup-grid { grid-template-columns: 1fr; gap: 32px; }
    .step-number { margin-bottom: 14px; }
    .setup-grid h3 { margin-bottom: 12px; }
    .audio-setup { margin-top: 42px; padding-top: 42px; }
    .section-intro { margin-bottom: 32px; }
    .screens-grid { gap: 32px 22px; }
    .screen-preview { padding: 10px 4px 25px; }
    .details-grid { margin-top: 42px; }
  }
  @media (max-width: 440px) {
    .listening-card { display: block; }
    .card-device { padding: 28px; }
    .screens-grid { gap: 28px 18px; }
    .screen-card h3 { font-size: 14px; }
    .screen-card figcaption p { font-size: 12px; }
    .details-grid { gap: 28px 20px; }
    .hero-actions { gap: 10px; }
    .action { padding-inline: 16px; gap: 12px; }
    .folder-example { padding: 20px; }
  }
  @media (max-width: 380px) {
    .hero-actions .action { flex: 1; padding-inline: 10px; gap: 8px; font-size: 12px; }
  }
</style>
