  <div class="face">
    <div class="screen">
      {src ? <img src={src} alt={alt} width="360" height="360" loading={eager ? 'eager' : 'lazy'} decoding="async" /> : <slot />}
    </div>
  </div>
</div>

<style>
  .device {
    position: relative;
    isolation: isolate;
    width: min(100%, var(--device-size));
    aspect-ratio: 1;
    margin-inline: auto;
    flex-shrink: 0;
  }
  .face {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: linear-gradient(145deg, #47494c 0%, #151719 26%, #060709 63%, #323438 100%);
    box-shadow: inset 0 1px 2px #ffffff70, inset 0 -2px 3px #000,
      0 3px 0 #080a0c, 0 7px 0 #15171a, 0 10px 0 #080a0c,
      0 20px 28px -12px #0007;
  }
  .enclosure { display: none; }
  .device[data-view='angled'] {
    aspect-ratio: 686 / 814;
    filter: drop-shadow(0 20px 14px #0003);
  }
  .device[data-view='angled'] .enclosure { display: block; width: 100%; height: 100%; }
  .device[data-view='angled'] .face {
    /* Map the 360px circular display onto the existing render's screen:
       centre (620, 450), radii (263, 160), in the 1280px source image.
       SVG viewBox crops the enclosure; the bitmap itself stays unchanged. */
    inset: auto;
    left: 11.80758%;
    top: 5.65111%;
    width: 76.67638%;
    aspect-ratio: 1;
    transform-origin: top center;
    transform: scaleY(.608365);
    background: none;
    box-shadow: none;
  }
  .device[data-view='angled'] .screen { inset: 0; box-shadow: none; }
  .screen {
    position: absolute;
    inset: 4.54545%;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: #080d13;
    box-shadow: 0 0 0 1px #000, 0 0 0 2px #ffffff0c;
    /* Isolates the video surface for reliable circular clipping on Safari. */
    transform: translateZ(0);
  }
  .screen :global(img), .screen :global(video) {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
  }
</style>
