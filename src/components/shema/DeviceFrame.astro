---
import { randomUUID } from 'node:crypto';
import { getImage } from 'astro:assets';
import enclosureArtwork from '../../../public/images/shema/device-home.png';

interface Props {
  src?: string;
  alt?: string;
  size?: number;
  eager?: boolean;
  view?: 'front' | 'angled';
}
const { src, alt = '', size = 396, eager = false, view = 'front' } = Astro.props;
const clipId = view === 'angled' ? `enclosure-${randomUUID()}` : undefined;
const enclosure = view === 'angled' ? await getImage({ src: enclosureArtwork, width: 1024, format: 'webp', quality: 90 }) : undefined;
---
