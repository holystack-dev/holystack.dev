---
import { metaLinks } from '../../data/metanoia';
---
<div class="stores">
  <a href={metaLinks.apple} aria-label="Download Metanoia on the App Store">
    <svg width="23" height="27" viewBox="0 0 24 28" fill="currentColor" aria-hidden="true"><path d="M17.1 4.4c1-1.2 1.7-2.8 1.5-4.4-1.5.1-3.3 1-4.4 2.2-1 1.1-1.8 2.7-1.5 4.3 1.7.1 3.4-.9 4.4-2.1ZM21 14.6c0-3.1 2.5-4.6 2.6-4.7-1.4-2.1-3.6-2.4-4.4-2.5-1.9-.2-3.7 1.1-4.6 1.1-1 0-2.5-1.1-4.1-1.1-2.1 0-4 1.2-5.1 3-2.2 3.7-.6 9.3 1.5 12.3 1 1.5 2.2 3.2 3.8 3.1 1.5 0 2.1-1 4-1s2.4 1 4.1 1c1.7 0 2.7-1.5 3.7-3 .9-1.1 1.5-2.5 1.8-3.4-.1 0-3.3-1.2-3.3-4.8Z" transform="translate(-2 1) scale(.94)"/></svg>
    <span><small>Download on the</small><strong>App Store</strong></span>
  </a>
  <a href={metaLinks.google} aria-label="Get Metanoia on Google Play">
    <svg width="23" height="27" viewBox="0 0 24 28" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true"><path d="M2 2v24l21-12L2 2Zm0 0 14 16M2 26 16 10"/></svg>
    <span><small>Get it on</small><strong>Google Play</strong></span>
  </a>
</div>
<style>
  .stores { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  a { display: flex; align-items: center; gap: 12px; padding: 10px 18px; border: 1px solid var(--site-button); border-radius: 10px; background: var(--site-button); color: var(--site-button-text); min-height: 60px; text-decoration: none; transition: transform .18s; }
  a:hover { transform: translateY(-2px); }
  span { display: flex; flex-direction: column; line-height: 1.2; }
  small { font-size: .59rem; letter-spacing: .02em; }
  strong { font-size: 1.06rem; font-weight: 500; margin-top: 3px; }
</style>
