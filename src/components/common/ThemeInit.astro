<script is:inline>
  (() => {
    const key = 'holystack-theme';
    const root = document.documentElement;
    const system = window.matchMedia('(prefers-color-scheme: dark)');
    let preference = 'system';
    const valid = value => ['light', 'dark', 'system'].includes(value);
    try { const stored = localStorage.getItem(key); if (valid(stored)) preference = stored; } catch {}
    const apply = () => {
      const resolved = preference === 'system' ? (system.matches ? 'dark' : 'light') : preference;
      root.dataset.theme = resolved;
      root.dataset.themePreference = preference;
      root.style.colorScheme = resolved;
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', resolved === 'dark' ? '#101b22' : '#faf8f4');
      document.dispatchEvent(new Event('holystack:theme-change'));
    };
    document.addEventListener('holystack:theme-request', event => {
      if (!valid(event.detail)) return;
      preference = event.detail;
      try { if (preference === 'system') localStorage.removeItem(key); else localStorage.setItem(key, preference); } catch {}
      apply();
    });
    system.addEventListener('change', () => { if (preference === 'system') apply(); });
    window.addEventListener('storage', event => {
      if (event.key !== key && event.key !== null) return;
      preference = valid(event.newValue) ? event.newValue : 'system';
      apply();
    });
    apply();
  })();
</script>
