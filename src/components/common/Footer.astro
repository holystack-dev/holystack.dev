---
import Brand from './Brand.astro';
import GitHubIcon from './GitHubIcon.astro';
import { projects } from '../../data/projects';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-studio"><Brand /><p class="footer-description">Free Catholic apps and open projects.<br />For prayer and growth in holiness.</p></div>
      <nav aria-label="Projects"><p class="footer-label">Projects</p>{projects.map(project => <a href={project.href}>{project.name}</a>)}<a href="/apps">All projects</a></nav>
      <nav aria-label="Resources"><p class="footer-label">Resources</p><a href="/metanoia/guide">Confession guide</a><a href="/shema/flash">Install Shema</a><a href="https://github.com/holystack-dev"><GitHubIcon /> GitHub</a></nav>
      <nav aria-label="Studio"><p class="footer-label">Studio</p><a href="/#studio">About HolyStack</a><a href="/contact">Contact</a><a href="/privacy">Privacy</a></nav>
    </div>
    <div class="footer-bottom"><p>© {year} HolyStack Ltd.</p></div>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--site-line); padding: 62px 0 28px; background: var(--site-card); }
  .footer-top { display: grid; grid-template-columns: 2fr 1fr 1.15fr 1fr; gap: 36px; }
  .footer-description { color: var(--site-muted); font-size: .8rem; line-height: 1.9; margin-top: 20px; }
  .footer-label { color: var(--site-accent); text-transform: uppercase; font-size: .63rem; font-weight: 600; letter-spacing: .14em; margin: 12px 0 16px; }
  nav a { color: var(--site-muted); text-decoration: none; display: flex; align-items: center; gap: 8px; min-height: 40px; font-size: .8rem; }
  nav a:hover { color: var(--site-accent); }
  nav a :global(svg) { width: 16px; height: 16px; }
  .footer-bottom { border-top: 1px solid var(--site-line); padding-top: 24px; margin-top: 48px; display: flex; justify-content: space-between; gap: 16px; font-size: .68rem; color: var(--site-muted); }
  @media(max-width: 1000px) { .footer-top { grid-template-columns: repeat(3,1fr); }.footer-studio { grid-column: 1/-1; } }
  @media(max-width: 520px) { .footer-top { grid-template-columns: 1fr 1fr; gap: 24px; }.footer-bottom { flex-direction: column; gap: 8px; }.site-footer { padding-top: 44px; } }
</style>
