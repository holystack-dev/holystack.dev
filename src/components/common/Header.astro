---
import Brand from './Brand.astro';
import ThemePicker from './ThemePicker.astro';
const links = [{href:'/apps',label:'Projects'},{href:'/metanoia',label:'Metanoia'},{href:'/shema',label:'Shema'},{href:'/contact',label:'Contact'}];
const pathname = Astro.url.pathname.replace(/\/$/, '');
---
<header class="site-header">
  <div class="wrap header-inner">
    <Brand />
    <div class="header-controls">
      <site-navigation>
        <button class="menu-toggle" aria-controls="site-navigation" aria-expanded="false" aria-label="Open navigation" hidden>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
        </button>
        <nav id="site-navigation" aria-label="Main navigation">
          {links.map(link => <a href={link.href} aria-current={pathname === link.href ? 'page' : pathname.startsWith(`${link.href}/`) ? 'location' : undefined}>{link.label}</a>)}
        </nav>
      </site-navigation>
      <ThemePicker/>
    </div>
  </div>
</header>
<noscript><style is:inline>
  @media (max-width: 860px) {
    .site-shell header.site-header { position: static; }
    .site-header .header-inner { height: auto; min-height: 72px; flex-wrap: wrap; padding-block: 10px; }
    .site-header .header-controls, .site-header site-navigation { width: 100%; }
    .site-header nav { position: static; display: flex; flex-wrap: wrap; gap: 8px 24px; padding: 0; border: 0; box-shadow: none; }
    .site-main { padding-top: 0; }
  }
</style></noscript>
<script>
  class SiteNavigation extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>('button')!;
      const nav = this.querySelector<HTMLElement>('nav')!;
      const media = matchMedia('(max-width: 860px)');
      let open = false;
      const update = () => {
        button.hidden = !media.matches;
        nav.hidden = media.matches && !open;
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      };
      button.addEventListener('click', () => { open = !open; update(); });
      this.addEventListener('keydown', e => {
        if (e.key === 'Escape' && open) { open = false; update(); button.focus(); }
      });
      document.addEventListener('click', e => {
        if (open && !this.contains(e.target as Node)) { open = false; update(); }
      });
      media.addEventListener('change', () => { open = false; update(); });
      update();
    }
  }
  if (!customElements.get('site-navigation')) customElements.define('site-navigation', SiteNavigation);
</script>
<style>
  .site-header { position: fixed; z-index: 50; top: 0; width: 100%; background: var(--site-bg); border-bottom: 1px solid var(--site-line); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; height: calc(var(--header-height) - 1px); gap: 20px; }
  .header-controls { display: flex; align-items: center; gap: 32px; }
  nav { display: flex; align-items: center; gap: 30px; }
  nav[hidden], button[hidden] { display: none; }
  nav a { display: inline-flex; align-items: center; min-height: 44px; font-size: .79rem; color: var(--site-muted); text-decoration: none; }
  nav a:hover, nav a[aria-current] { color: var(--site-accent); }
  nav a[aria-current] { text-decoration: underline; text-underline-offset: 7px; }
  .menu-toggle { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 1px solid var(--site-line); border-radius: 50%; color: var(--site-ink); background: var(--site-card); cursor: pointer; }
  @media (max-width: 860px) {
    .header-controls { gap: 8px; }
    site-navigation { order: 2; }
    nav { position: absolute; top: var(--header-height); left: 0; right: 0; display: grid; gap: 0; padding: 14px 24px 22px; background: var(--site-card); border-bottom: 1px solid var(--site-line); box-shadow: var(--site-shadow); }
    nav a { font-size: 1rem; padding: 8px 0; }
  }
  @media (max-width: 420px) { .header-inner :global(.brand-logo) { width: 152px; } }
</style>
